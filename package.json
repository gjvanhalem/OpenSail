{
  "name": "opensail",
  "version": "1.0.0",
  "description": "Open-source marine navigation system",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "setup-native": "node setup-native.js",
    "windows-check": "node -e \"console.log('\\n📱 Windows Setup:\\n'); console.log('1. Install Android Studio'); console.log('2. Create Android emulator'); console.log('3. Run: npm run setup-native'); console.log('4. Run: npm start'); console.log('5. Run: npm run android\\n'); console.log('See WINDOWS_SETUP.md for details\\n')\"",
    "dev": "npm run build && npm run test:watch",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "marine",
    "navigation",
    "nmea",
    "gps",
    "chart"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.21.0",
    "@reduxjs/toolkit": "^2.2.0",
    "@rnmapbox/maps": "^10.1.0",
    "react": "^18.2.0",
    "react-native": "^0.74.0",
    "react-native-fs": "^2.20.0",
    "react-native-sqlite-storage": "^6.0.1",
    "react-redux": "^9.1.0",
    "redux": "^5.0.1",
    "rxjs": "^7.8.1",
    "serialport": "^12.0.0",
    "uuid": "^9.0.1",
    "react-native-windows": "0.74.0"
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.74.89",
    "@react-native/metro-config": "^0.74.89",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.2.0",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-native": "^4.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0",
    "react-native-cli": "^2.0.1",
    "react-native-windows": "^0.74.0",
    "ts-jest": "^29.1.2",
    "typescript": "~5.4.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}