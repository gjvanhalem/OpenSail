# OpenSail needs no .env for development: no API keys or map tokens.
# The chart uses free OpenFreeMap / OpenStreetMap tiles and OpenSeaMap seamarks.
#
# Optional settings (copy this file to .env to use them):

# Where the app finds the chart catalog (index.json) and PMTiles archives.
# Default: charts/index.json on the app's own host (pwa/public/charts in development,
# /charts on the Zimablade). The Windows and Android apps use .env.native, which points
# at the public github.com/gjvanhalem/opensail-charts releases.
# VITE_CHART_CATALOG_URL=https://example.com/charts/index.json
