# No map token is needed: the chart uses free OpenStreetMap tiles from OpenFreeMap.

# Optional: Backend API endpoint
# VITE_API_ENDPOINT=https://api.example.com

# Optional: Environment identifier
# VITE_ENVIRONMENT=production

# Deployment Notes:
# - Copy this file to .env for local development
# - Set environment variables in your hosting platform (Netlify, Vercel, etc.)
# - Never commit a .env file with secrets to version control
